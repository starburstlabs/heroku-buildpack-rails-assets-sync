#!/usr/bin/env bash
# usage: bin/compile BUILD_DIR CACHE_DIR ENV_DIR

BUILD_DIR="$1"
CACHE_DIR="$2"
ENV_DIR="$3"

requireVar(){
  local var="$1"
  local default="$2"
  local value

  if [ -e "$ENV_DIR/$var" ]; then
    value="$(cat "$ENV_DIR/$var")"
  elif [ -n "$default" ]; then
    echo "$var is not set, using default value: $default" >&2
    value="$default"
  fi

  if [ -n "$value" ]; then
    export "$var"="$value"
    return 0
  fi

  echo "$var is not set or empty and no default value provided" >&2
  return 1
}

requireVar CDN_HOST_BUCKET "unset"
requireVar CDN_HOST "unset"

if [ "$CDN_HOST_BUCKET" = "unset" ]; then
  if [ "$CDN_HOST" = "unset" ]; then
    echo "skipping asset sync, CDN_HOST and CDN_HOST_BUCKET are not set" >&2
    exit 0
  fi
  CDN_HOST_BUCKET="$CDN_HOST"
fi

requireVar AWS_ACCESS_KEY_ID || exit 1
requireVar AWS_SECRET_ACCESS_KEY || exit 1
requireVar AWS_DEFAULT_REGION "us-east-1" || exit 1
S3SYNC_DEFAULT_URL="https://github.com/nidor1998/s3sync/releases/download/v1.62.0/s3sync-1.62.0-linux-glibc2.28-x86_64.tar.gz"
S3SYNC_DEFAULT_SHA256="a781c0c77ffda061ecd8ddaac08f298de318b7d46b45dc90335eee4bc7da969c"
requireVar S3SYNC_URL "$S3SYNC_DEFAULT_URL"
requireVar BUILDPACK_REMOVE_ASSETS_FROM_SLUG "false"

[ -d "$CACHE_DIR" ] || mkdir -p "$CACHE_DIR"
s3sync_cache_key=$(printf '%s' "$S3SYNC_URL" | sha256sum | cut -d ' ' -f 1)
s3sync_bin="$CACHE_DIR/s3sync-$s3sync_cache_key"
if [ -x "$s3sync_bin" ]; then
  echo "using s3sync from cache" >&2
else
  echo "downloading s3sync from $S3SYNC_URL" >&2
  s3sync_download=$(mktemp -d)
  cleanup_s3sync_download() {
    [ -n "${s3sync_download:-}" ] && rm -rf -- "$s3sync_download"
  }
  trap cleanup_s3sync_download EXIT
  curl --fail --location --retry 5 --retry-all-errors --retry-delay 2 \
    --output "$s3sync_download/s3sync.tar.gz" "$S3SYNC_URL" || exit 1
  if [ "$S3SYNC_URL" = "$S3SYNC_DEFAULT_URL" ]; then
    echo "$S3SYNC_DEFAULT_SHA256  $s3sync_download/s3sync.tar.gz" \
      | sha256sum --check --status || {
        echo "ERROR: S3Sync archive checksum does not match" >&2
        exit 1
      }
  fi
  tar -xzf "$s3sync_download/s3sync.tar.gz" -C "$s3sync_download" s3sync || exit 1
  install -m 755 "$s3sync_download/s3sync" "$s3sync_bin" || exit 1
fi

ASSETS_DIR="$BUILD_DIR/public/assets"
PRESERVED_ASSETS_DIR="$BUILD_DIR/tmp/buildpack-saved-assets"
PRESERVED_ASSETS_MANIFEST="$BUILD_DIR/public/assets.preserved"

# Copy the most recent sprockets manifest to a known path so consumers can
# always find it (matches action-sync-assets behavior)
latest_manifest=$(ls -t "$ASSETS_DIR"/.sprockets-manifest* 2>/dev/null | head -1)
if [ -n "$latest_manifest" ]; then
  cp "$latest_manifest" "$ASSETS_DIR/.sprockets-manifest-latest.json"
  echo "created .sprockets-manifest-latest.json from $(basename "$latest_manifest")"
else
  echo "WARNING: No sprockets manifest file found, skipping latest manifest creation" >&2
fi

echo "syncing assets to $CDN_HOST_BUCKET"
if ! "$s3sync_bin" --remove-modified-filter "$ASSETS_DIR" "s3://$CDN_HOST_BUCKET/assets/"; then
  echo "ERROR: Failed to sync assets to S3" >&2
  exit 1
fi
echo "Asset sync completed successfully"

if [ "$BUILDPACK_REMOVE_ASSETS_FROM_SLUG" = "true" ]; then
  echo "removing assets from slug"

  mkdir -p "$PRESERVED_ASSETS_DIR"
  if [ -f "$PRESERVED_ASSETS_MANIFEST" ]; then
    echo "preserving assets listed in $PRESERVED_ASSETS_MANIFEST"
    while IFS= read -r line; do
      # Skip comment and blank lines
      [[ "$line" =~ ^[[:space:]]*# ]] && continue
      [[ -z "${line// }" ]] && continue
      # Handle glob patterns
      if [[ "$line" == *"*"* ]]; then
        for file in "$ASSETS_DIR"/$line; do
          if [ -f "$file" ]; then
            filename=$(basename "$file")
            cp "$file" "$PRESERVED_ASSETS_DIR/$filename"
          fi
        done
      else
        cp "$ASSETS_DIR/$line" "$PRESERVED_ASSETS_DIR/$line"
      fi
    done < "$PRESERVED_ASSETS_MANIFEST"
  fi

  rm -rf "$ASSETS_DIR"
  mv "$PRESERVED_ASSETS_DIR" "$ASSETS_DIR"
  echo "persisted assets:"
  (
    cd "$ASSETS_DIR" &>/dev/null || exit 0
    find . -type f | sed 's/^\.\///'
  )
else
  echo "keeping assets in slug"
fi
